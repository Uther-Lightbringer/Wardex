{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WarDex",
  "version": "0.0.16",
  "identifier": "com.wardex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
      "withGlobalTauri": true,
    "windows": [
      {
        "title": "WarDex",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "../pi-runtime/packages/coding-agent/dist": "pi/packages/coding-agent/dist",
      "../pi-extensions": "pi-extensions",
      "../pi-packages": "pi-packages"
    }
  }
}
